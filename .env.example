# ─────────────────────────────────────────────────────────────────────────────
# ZeFi — environment configuration
# Copy to `.env.local` for local development. Never commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Leave empty to run the app without persistence
# (conversations and plans become session-scoped and are labelled as such).
#
# Supabase: use the *transaction* pooler (port 6543) at runtime, and the
# *session* pooler (port 5432) for migrations — pgbouncer cannot run DDL.
#   postgresql://postgres.<ref>:<pw>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# URL-encode special characters in the password: @ → %40, # → %23, ! → %21.
DATABASE_URL=
NEXT_PUBLIC_APP_URL=https://zefi.ae

# ── Authentication (Clerk) ───────────────────────────────────────────────────
# https://dashboard.clerk.com → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# ── AI ───────────────────────────────────────────────────────────────────────
# ZeFi's default provider is OpenAI. Anthropic ships as a fully-implemented
# alternative behind the same interface — set AI_PROVIDER=anthropic to use it.
# Leave AI_PROVIDER unset to auto-select whichever provider is fully configured.
AI_PROVIDER=openai

# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Model id is never hardcoded in source. Set the model your key is entitled to.
OPENAI_MODEL=
# Optional: for an Azure/OpenAI-compatible gateway.
OPENAI_BASE_URL=

# Alternative provider — https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Shared tuning across providers
AI_MAX_TOKENS=2048
AI_TIMEOUT_MS=45000

# ── Wallet connection ────────────────────────────────────────────────────────
# https://cloud.reown.com (formerly WalletConnect Cloud)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ── Routefold ────────────────────────────────────────────────────────────────
# Public URL of the Routefold deployment. Falls back to the on-site product page.
NEXT_PUBLIC_ROUTEFOLD_URL=

# ── JSON-RPC endpoints ───────────────────────────────────────────────────────
# Public fallbacks are used when a value is omitted. Provide dedicated endpoints
# (Alchemy / Infura / QuickNode) for production — public RPCs rate limit hard.
RPC_URL_ETHEREUM=
RPC_URL_BASE=
RPC_URL_ARBITRUM=
RPC_URL_OPTIMISM=
RPC_URL_POLYGON=

# Client-side RPC overrides (optional). When unset, the browser uses the chain's
# public endpoint and all balance reads are proxied through the server instead.
NEXT_PUBLIC_RPC_URL_ETHEREUM=
NEXT_PUBLIC_RPC_URL_BASE=
NEXT_PUBLIC_RPC_URL_ARBITRUM=
NEXT_PUBLIC_RPC_URL_OPTIMISM=
NEXT_PUBLIC_RPC_URL_POLYGON=

# ── Feature flags ────────────────────────────────────────────────────────────
# Master switch for submitting transactions for wallet signature.
# When false, ZeFi builds and simulates plans but never requests a signature.
TRANSACTION_EXECUTION_ENABLED=false
NEXT_PUBLIC_TRANSACTION_EXECUTION_ENABLED=false

# Demo mode serves deterministic, explicitly-labelled fixture data so the product
# can be shown without credentials. It is NEVER used as a silent fallback when a
# configured provider fails — failures surface as errors.
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true

# ── Simulation provider (optional, provider-ready) ───────────────────────────
# When unset, ZeFi performs local deterministic validation only and reports
# deeper simulation as unavailable. It never claims a simulation that did not run.
SIMULATION_PROVIDER=
SIMULATION_PROVIDER_API_KEY=
SIMULATION_PROVIDER_ACCOUNT=
SIMULATION_PROVIDER_PROJECT=

# ── Swap / bridge routing providers (optional, provider-ready) ───────────────
SWAP_PROVIDER=
SWAP_PROVIDER_API_KEY=
BRIDGE_PROVIDER=
BRIDGE_PROVIDER_API_KEY=

# ── Portfolio / token pricing provider (optional, provider-ready) ────────────
PORTFOLIO_PROVIDER=
PORTFOLIO_PROVIDER_API_KEY=

# ── Rate limiting ────────────────────────────────────────────────────────────
# In-memory limiter is used by default (per-instance). Set these to use Upstash
# Redis for a shared limiter across serverless instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_AI_PER_MINUTE=12
RATE_LIMIT_AI_PER_DAY=250
